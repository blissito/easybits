{
  "name": "easybits",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "react-router dev",
    "prebuild": "npx tsx scripts/docs-sync.mts --write && npx tsx scripts/skills-pack.mts --write",
    "build": "react-router build",
    "check:skills": "npx tsx scripts/skills-pack.mts",
    "check:docs": "npx tsx scripts/docs-sync.mts",
    "docs:sync": "npx tsx scripts/docs-sync.mts --write",
    "skills:pack": "npx tsx scripts/skills-pack.mts --write",
    "skills:publish": "npm run check:skills && git subtree push --prefix public/skills git@github.com:blissito/easybits-skills.git main",
    "start": "cross-env NODE_ENV=production node server.mjs ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "npx playwright test test/e2e-purchase.spec.ts --headed"
  },
