{
  "name": "@easybits.cloud/cli",
  "version": "0.19.2",
  "description": "Official CLI for EasyBits, the cloud for AI agents — sandboxes, hosting, domains, databases, agents and files from your terminal",
  "type": "module",
  "bin": {
    "easybits": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "easybits",
    "cli",
    "sandboxes",
    "microvm",
    "hosting",
    "ai-agents",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blissito/easybits",
    "directory": "cli"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --no-warnings --import ./scripts/ts-resolve.mjs --test src/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@easybits.cloud/sdk": "^0.36.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
