{
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "services/captions/**/*",
    // Configs de build de los subpaquetes: cada uno es un paquete npm aparte,
    // con su propio tsconfig y su propio `tsup` en su node_modules — que la
    // raíz NO instala. Incluirlos hacía que `npm run typecheck` fallara en
    // cualquier clon limpio con "Cannot find module 'tsup'", un error que no
    // dice nada de la app.
    "packages/*/tsup.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
