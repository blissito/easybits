{
  "name": "@easybits.cloud/sdk",
  "version": "0.36.0",
  "description": "Typed HTTP client for the EasyBits cloud for AI agents — sandboxes, web, files, SQL databases, documents and app hosting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "easybits",
    "sdk",
    "file-management",
    "storage",
    "api-client",
    "digital-assets",
    "agentic",
    "mcp",
    "ai-agents",
    "webhooks",
    "agent-skills",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blissito/easybits",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "prepack": "rm -rf skills && cp -R ../../public/skills skills && rm -f skills/*.tar.gz skills/index.json skills/index.legacy.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
