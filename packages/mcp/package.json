{
  "name": "@easybits.cloud/mcp",
  "version": "0.3.4",
  "mcpName": "cloud.easybits/easybits",
  "description": "MCP server for EasyBits — the cloud for AI agents: sandboxes, web, files, SQL databases, documents and app hosting",
  "type": "module",
  "bin": {
    "easybits-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "easybits",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-tools",
    "stdio",
    "agent-skills",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blissito/easybits",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "prepack": "rm -rf skills && cp -R ../../public/skills skills && rm -f skills/*.tar.gz skills/index.json skills/index.legacy.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
